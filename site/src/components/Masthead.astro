---
interface Props {
  current: "map" | "policies";
}
const { current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const links = [
  { id: "map", href: `${base}/`, label: "Coverage map" },
  { id: "policies", href: `${base}/policies/`, label: "Policies" },
] as const;
---

<header class="masthead">
  <svg class="stars" viewBox="0 0 92 20" aria-hidden="true">
    {[0, 1, 2, 3].map((i) => (
      <path
        transform={`translate(${10 + i * 24} 10)`}
        d="M0-10 2.6-4.5 8.7-5 5.2 0 8.7 5 2.6 4.5 0 10-2.6 4.5-8.7 5-5.2 0-8.7-5-2.6-4.5Z"
      />
    ))}
  </svg>
  <h1>Chicago bike network</h1>
  <nav class="nav" aria-label="Pages">
    {links.map((l) => <a href={l.href} aria-current={l.id === current ? "page" : undefined}>{l.label}</a>)}
  </nav>
</header>
